{
  "logging": {
    "level": "INFO",
    "format": "[{level}({function})] {timestamp} - {message}",
    "include_traceback": true,
    "use_filtering" : true,
    "filtered_functions": [
      "_initialize",
      "_load_config",
      "_create_all_tables",
      "empty_all_tables",
      "_create_default_users_fallback",
      "_load_potential_modules",
      "_sync_with_disk",
      "_recursive_discover",
      "_discover_ui_modules",
      "ensure_initialized",
      "_load_plugin",
      "initialize",
      "clear_all_documents",
      "upload_document",
      "dispose",
      "discover_engines",
      "__init__",
      "_run_initialize_hooks",
      "_load_indices",
      "_init_data_directory",
      "_call_module_hook",
      "_register_monitor_callback",
      "on_module_activated",
      "load_all_translations",
      "load_all_prompts",
      "validate_config",
      "initialize_current_llm",
      "_get_embedding_model",
      "auto_login_first_user",
      "_render_plugins_tab",
      "_activate_rag_engine",
      "_do_discover",
      "_do_build_registry"
    ]
  },
  "app": {
    "name": "Professor",
    "default_llm": "groq",
    "version": "1.0.0",
    "auto_login": true,
    "auto_login_user": "master2",
    "local_mode": true,
    "test_mode": false
  },
  "ui": {
    "shared_dir": "st_shared"
  },
  "database": {
    "path": "sqlite:///data/app.db",
    "auto_create_tables": true,
    "create_default_users": false,
    "auto_import_users": {
      "enabled": true,
      "file": "tests/initial_users.json",
      "overwrite": false,
      "description": "Auto-import users from JSON file if no users exist"
    },
    "auto_import_conversations": {
      "enabled": true,
      "files": [
        {
          "file": "tests/sample_conversation.yaml",
          "user_id": "normal1_m1",
          "description": "Sample conversation for normal user",
          "overwrite": false
        }
      ],
      "description": "Auto-import conversations from YAML files for specific users"
    }
  },
  "llms": {
    "mock": {
      "type": "mock",
      "model": "mock-fast",
      "name": "Mock LLM",
      "enabled": true,
      "description": "Mock LLM for testing",
      "requires_api_key": false
    },
    "ollama_qwen": {
      "type": "ollama",
      "model": "qwen3:4b",
      "name": "Ollama Small",
      "enabled": true,
      "description": "Local Qwen model via Ollama",
      "requires_api_key": false
    },
    "gemini": {
      "type": "gemini",
      "model": "gemini-2.5-flash",
      "enabled": true,
      "description": "Google's fast multimodal model",
      "requires_api_key": true
    },
    "groq": {
      "type": "groq",
      "model": "llama-3.3-70b-versatile",
      "name": "Groq Llama 3",
      "enabled": true,
      "description": "Fast inference via Groq",
      "requires_api_key": true
    }
  }
}
