{
  "logging": {
    "level": "INFO",
    "format": "[{level}] {timestamp} - {message}",
    "include_traceback": true
  },
  "app": {
    "name": "Professor",
    "default_llm": "Groq Llama 3",
    "version": "1.0.0",
    "auto_login": true,
    "auto_login_user": "master1",
    "local_mode": true,
    "test_mode": false
  },
  "database": {
    "path": "sqlite:///data/app.db",
    "auto_create_tables": true,
    "create_default_users": false,
    "auto_import_users": {
      "enabled": true,
      "file": "tests/initial_users.json",
      "overwrite": false,
      "description": "Auto-import users from JSON file if no users exist"
    },
    "auto_import_conversations": {
      "enabled": true,
      "files": [
        {
          "file": "tests/sample_conversation.yaml",
          "user_id": "normal1_m1",
          "description": "Sample conversation for normal user",
          "overwrite": false
        }
      ],
      "description": "Auto-import conversations from YAML files for specific users"
    }
  },
  "llms": {
    "mock": {
      "type": "mock",
      "model": "mock-fast",
      "name": "Mock LLM",
      "enabled": true,
      "description": "Mock LLM for testing",
      "requires_api_key": false
    },
    "ollama_qwen": {
      "type": "ollama",
      "model": "qwen3:4b",
      "name": "Ollama Small",
      "enabled": true,
      "description": "Local Qwen model via Ollama",
      "requires_api_key": false
    },
    "gemini": {
      "type": "gemini",
      "model": "gemini-2.5-flash",
      "enabled": true,
      "description": "Google's fast multimodal model",
      "requires_api_key": true
    },
    "groq": {
      "type": "groq",
      "model": "llama-3.3-70b-versatile",
      "name": "Groq Llama 3",
      "enabled": true,
      "description": "Fast inference via Groq",
      "requires_api_key": true
    }
  }
}
