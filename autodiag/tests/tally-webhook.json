        ],
        "options": [
          {
            "id": "829478f4-e13c-4859-ae0b-1d15982a3fcb",
            "text": "Oui, globalement"
          },
          {
            "id": "b370304f-db4d-4028-8478-ff4fad31fedd",
            "text": "Non, ou rarement"
          },
          {
