{
  "app": {
    "default_llm": "mock",
    "auto_login": false,
    "local_mode": true,
    "test_mode": true,
    "debug_llm": ["ollama_qwen", "groq", "gemini"],
    "llm_delay": 500
  },
  "database": {
    "path": "sqlite:///tests/data/app.db",
    "auto_create_tables": true,
    "create_default_users": true
  },
  "embedding": {
    "model_name": "all-MiniLM-L6-v2",
    "vector_dimension": 384
  },
  "llms": {
    "mock": {
      "type": "mock",
      "model": "mock-fast",
      "name": "Mock LLM",
      "enabled": true,
      "description": "Mock LLM for testing",
      "requires_api_key": false
    },
    "ollama_qwen": {
      "type": "ollama",
      "model": "qwen3:1.7b",
      "name": "Ollama Small",
      "enabled": true,
      "description": "Local Qwen model via Ollama",
      "requires_api_key": false
    },
    "gemini": {
      "type": "gemini",
      "model": "gemini-2.5-flash",
      "name": "Gemini",
      "enabled": false,
      "description": "Google's fast multimodal model",
      "requires_api_key": true
    },
    "groq": {
      "type": "groq",
      "model": "llama-3.3-70b-versatile",
      "name": "Groq Llama 3",
      "enabled": true,
      "description": "Fast inference via Groq",
      "requires_api_key": true
    }
  }
}
