{
  "app": {
    "default_llm": "Mock LLM",
    "auto_login": false,
    "local_mode": true,
    "test_mode": true,
    "debug_llm": ["Qwen 3 4b", "Groq Llama 3"],
    "llm_delay": 5000
  },
  "database": {
    "path": "tests/data",
    "auto_create_tables": true,
    "create_default_users": true
  },
  "llms": {
    "mock": {
      "type": "mock",
      "model": "mock-fast",
      "name": "Mock LLM",
      "enabled": true,
      "description": "Mock LLM for testing",
      "requires_api_key": false
    },
    "ollama_qwen": {
      "type": "ollama",
      "model": "qwen3:4b",
      "name": "Qwen 3 4B",
      "enabled": true,
      "description": "Local Qwen model via Ollama",
      "requires_api_key": false
    },
    "gemini": {
      "type": "gemini",
      "model": "gemini-2.5-flash",
      "enabled": false,
      "description": "Google's fast multimodal model",
      "requires_api_key": true
    },
    "groq": {
      "type": "groq",
      "model": "llama-3.3-70b-versatile",
      "name": "Groq Llama 3",
      "enabled": true,
      "description": "Fast inference via Groq",
      "requires_api_key": true
    }
  }
}
