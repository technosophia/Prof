{
  "rag_manager": {
    "data_directory": "tests/data/rag_documents",
    "default_engine": "classic",
    "auto_import": [],
    "engines": {
      "simple": {
        "enabled": true,
        "index_path": "tests/data/simple_indexes"
      },
      "classic": {
        "enabled": true,
        "index_path": "tests/data/classic_indexes",
        "chunk_size": 500,
        "chunk_overlap": 50,
        "similarity_threshold": 0.3
      },
      "faiss_hierarchical": {
        "enabled": true,
        "index_path": "tests/data/hierarchical_indexes"
      }
    }
  }
}
