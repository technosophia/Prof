{
  "rag_manager": {
    "data_directory": "data/rag_documents",
    "allowed_extensions": [".txt", ".pdf", ".md", ".docx", ".csv", ".json"],
    "max_file_size_mb": 20,
    "default_engine": "classic",
    "engines": {
      "simple": {
        "enabled": true,
        "index_path": "data/simple_indexes",
        "description": "Simple keyword-based search engine"
      },
      "classic": {
        "enabled": true,
        "description": "Classic vector store with embeddings",
        "index_path": "data/classic_indexes",
        "chunk_size": 500,
        "chunk_overlap": 50,
        "similarity_threshold": 0.3
      },
      "faiss_hierarchical": {
        "enabled": true,
        "description": "FAISS vector store with hierarchical markdown parsing",
        "index_path": "data/hierarchical_indexes",
        "similarity_threshold": 0.3
      },
      "faiss_hierarchical_v2": {
        "enabled": true,
        "description": "FAISS V2 vector store with hierarchical markdown parsing Enhanced",
        "index_path": "data/hierarchical_indexes_v2",
        "similarity_threshold": 0.3,
        "level_boost": {
          "summary": 1.6,
          "section": 1.2,
          "paragraph": 1.0
        },
        "summary_slots": 1
      }
    }
  }
}
