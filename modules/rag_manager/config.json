{
  "rag_manager": {
    "data_directory": "./data/rag_documents",
    "allowed_extensions": [".txt", ".pdf", ".md", ".docx", ".csv", ".json"],
    "max_file_size_mb": 20,
    "default_engine": "simple",
    "engines": {
      "simple": {
        "enabled": true,
        "description": "Simple keyword-based search engine"
      },
      "faiss": {
        "enabled": true,
        "description": "FAISS vector store with embeddings",
        "faiss_index_path": "./data/faiss_indexes",
        "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
        "chunk_size": 500,
        "chunk_overlap": 50,
        "similarity_threshold": 0.7
      }
    }
  }
}
