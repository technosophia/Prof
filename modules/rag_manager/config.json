{
  "rag_manager": {
    "data_directory": "data/rag_documents",
    "allowed_extensions": [".txt", ".pdf", ".md", ".docx", ".csv", ".json"],
    "max_file_size_mb": 20,
    "default_engine": "faiss_hierarchical",
    "engines": {
      "simple": {
        "enabled": true,
        "index_path": "data/simple_indexes",
        "description": "Simple keyword-based search engine"
      },
      "classic": {
        "enabled": true,
        "description": "FAISS vector store with embeddings",
        "index_path": "data/classic_indexes",
        "chunk_size": 500,
        "chunk_overlap": 50,
        "similarity_threshold": 0.3
      },
      "faiss_hierarchical": {
        "enabled": true,
        "description": "FAISS vector store with hierarchical markdown parsing",
        "index_path": "data/hierarchical_indexes",
        "similarity_threshold": 0.5
      }
    }
  }
}
