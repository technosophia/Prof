{
  "rag_manager": {
    "data_directory": "data/rag_documents",
    "allowed_extensions": [
      ".txt",
      ".pdf",
      ".md",
      ".docx",
      ".csv",
      ".json"
    ],
    "max_file_size_mb": 20,
    "default_engine": "hybrid_bm25_blend_no_hyde",

    "result_limits": {
      "default": 3,
      "min": 1,
      "max": 20,
      "context_injection": 3,
      "search_test": 5,
      "per_engine": {
        "hybrid_bm25_blend": 3,
        "structured_sheet": 3,
        "simple": 5,
        "classic": 5
      }
    },

    "engines": {

      "simple": {
        "type": "simple",
        "enabled": true,
        "index_path": "data/simple_indexes",
        "description": "Simple keyword-based search engine"
      },

      "classic": {
        "type": "classic",
        "enabled": true,
        "description": "Classic vector store with embeddings",
        "index_path": "data/classic_indexes",
        "chunk_size": 500,
        "chunk_overlap": 50,
        "similarity_threshold": 0.3
      },

      "faiss_hierarchical": {
        "_comment": "Backward-compatible drop-in for the original v1 engine. hierarchical chunking + flat search.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — v1 compat (flat search, section chunks)",
        "index_path": "data/hierarchical_indexes",
        "chunk_strategy": "hierarchical",
        "search_mode": "flat",
        "similarity_threshold": 0.3,
        "level_boost": {
          "summary": 1.0,
          "section": 1.0,
          "paragraph": 1.0
        },
        "summary_slots": 0
      },

      "faiss_hier_flat_boosted": {
        "_comment": "Flat search with summary-slot injection and per-level boosts — tests whether forcing a summary chunk into every result set improves coverage on broad queries.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — flat + level boosts + 1 summary slot",
        "index_path": "data/hierarchical_indexes/flat_boosted",
        "chunk_strategy": "hierarchical",
        "search_mode": "flat",
        "similarity_threshold": 0.25,
        "level_boost": {
          "summary": 1.6,
          "section": 1.2,
          "paragraph": 1.0
        },
        "summary_slots": 1
      },

      "faiss_hier_cascade": {
        "_comment": "Inverted sieve cascade (BM25 → paragraph → section → summary). Multi-level indexing required. Equivalent to the former faiss_hierarchical_v2 engine with default parameters.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — cascade (BM25→para→sec→summ)",
        "index_path": "data/hierarchical_indexes/cascade",
        "chunk_strategy": "multi_level",
        "search_mode": "cascade",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "bm25_dominance_ratio": 2.0,
        "bm25_min_score": 1.0,
        "dense_margin_ratio": 1.3,
        "dense_min_score": 0.30,
        "floor_threshold": 0.15,
        "top_k_for_margin": 5
      },

      "faiss_hier_cascade_tight": {
        "_comment": "Cascade with tighter confidence gates.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — cascade, tighter confidence gates",
        "index_path": "data/hierarchical_indexes/cascade_tight",
        "chunk_strategy": "multi_level",
        "search_mode": "cascade",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "bm25_dominance_ratio": 3.0,
        "bm25_min_score": 2.0,
        "dense_margin_ratio": 1.6,
        "dense_min_score": 0.40,
        "floor_threshold": 0.20,
        "top_k_for_margin": 5
      },

      "faiss_hier_cascade_loose": {
        "_comment": "Cascade with looser gates — stages fire more eagerly.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — cascade, loose confidence gates",
        "index_path": "data/hierarchical_indexes/cascade_loose",
        "chunk_strategy": "multi_level",
        "search_mode": "cascade",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "bm25_dominance_ratio": 1.5,
        "bm25_min_score": 0.5,
        "dense_margin_ratio": 1.1,
        "dense_min_score": 0.20,
        "floor_threshold": 0.10,
        "top_k_for_margin": 8
      },

      "faiss_hier_bm25_only": {
        "_comment": "Pure BM25 retrieval, no dense search at all.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — BM25 only (keyword baseline)",
        "index_path": "data/hierarchical_indexes/bm25_only",
        "chunk_strategy": "multi_level",
        "search_mode": "bm25_only",
        "paragraph_size": 500,
        "paragraph_overlap": 80
      },

      "faiss_hier_dense_only": {
        "_comment": "Dense search over all chunks with confidence gate but no cascade.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — dense only, confidence-gated",
        "index_path": "data/hierarchical_indexes/dense_only",
        "chunk_strategy": "multi_level",
        "search_mode": "dense_only",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "similarity_threshold": 0.25,
        "dense_margin_ratio": 1.3,
        "dense_min_score": 0.30,
        "top_k_for_margin": 5
      },

      "faiss_hier_paragraph_only": {
        "_comment": "Dense search restricted to fine-grained PARAGRAPH chunks only.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — paragraph-level dense only",
        "index_path": "data/hierarchical_indexes/paragraph_only",
        "chunk_strategy": "multi_level",
        "search_mode": "paragraph",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "similarity_threshold": 0.25
      },

      "faiss_hier_paragraph_wide": {
        "_comment": "Paragraph-only retrieval with larger chunks (600 chars) and more overlap (100).",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — wide paragraph chunks (600 chars)",
        "index_path": "data/hierarchical_indexes/paragraph_wide",
        "chunk_strategy": "multi_level",
        "search_mode": "paragraph",
        "paragraph_size": 600,
        "paragraph_overlap": 100,
        "similarity_threshold": 0.25
      },

      "faiss_hier_section_only": {
        "_comment": "Dense search restricted to SECTION chunks only.",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — section-level dense only",
        "index_path": "data/hierarchical_indexes/section_only",
        "chunk_strategy": "multi_level",
        "search_mode": "section",
        "paragraph_size": 500,
        "paragraph_overlap": 80,
        "similarity_threshold": 0.25
      },

      "faiss_hier_summary_only": {
        "_comment": "Dense search on SUMMARY chunks only (>[!Résumé] blocks).",
        "type": "faiss_hierarchical",
        "enabled": false,
        "description": "FAISS hierarchical — summary-level dense only",
        "index_path": "data/hierarchical_indexes/summary_only",
        "chunk_strategy": "multi_level",
        "search_mode": "summary",
        "similarity_threshold": 0.15
      },

      "hybrid": {
        "type": "hybrid",
        "enabled": false,
        "description": "Hybrid RAG: HyDE + sentence-window + BM25 + contextual chunks",
        "index_path": "data/hybrid_indexes/default",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "chunk_size": 400,
        "chunk_overlap": 60,
        "sentence_window_size": 3,
        "dynamic_chunk_sizes": [150, 300, 500],
        "hyde": true,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": true,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_no_hyde": {
        "type": "hybrid",
        "enabled": false,
        "description": "Hybrid: no HyDE (baseline for HyDE comparison)",
        "index_path": "data/hybrid_indexes/hybrid_no_hyde",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "chunk_size": 400,
        "chunk_overlap": 60,
        "sentence_window_size": 3,
        "dynamic_chunk_sizes": [150, 300, 500],
        "hyde": false,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": true,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_no_hyde_no_dynamic": {
        "type": "hybrid",
        "enabled": false,
        "description": "Hybrid RAG: no HyDE, no dynamic chunk sizes",
        "index_path": "data/hybrid_indexes/hybrid_no_hyde_no_dynamic",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "chunk_size": 400,
        "chunk_overlap": 60,
        "sentence_window_size": 3,
        "hyde": false,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": true,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_wide_window": {
        "type": "hybrid",
        "enabled": false,
        "description": "Hybrid: wider sentence window (±5) for richer context",
        "index_path": "data/hybrid_indexes/hybrid_wide_window",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "sentence_window_size": 5,
        "hyde": true,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": true,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_bm25_blend": {
        "type": "hybrid",
        "enabled": true,
        "description": "Hybrid: full BM25 blend (alpha=0.6) instead of tiebreaker",
        "index_path": "data/hybrid_indexes/hybrid_bm25_blend",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "sentence_window_size": 3,
        "hyde": true,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.6,
        "bm25_rerank_only": false,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_bm25_blend_no_hyde": {
        "type": "hybrid",
        "enabled": true,
        "description": "Hybrid: full BM25 blend (alpha=0.6), no HyDE",
        "index_path": "data/hybrid_indexes/hybrid_bm25_blend_no_hyde",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "sentence_window_size": 3,
        "hyde": false,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.6,
        "bm25_rerank_only": false,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "hybrid_hyde_summaries": {
        "type": "hybrid",
        "enabled": false,
        "description": "Hybrid: HyDE grounded with >[!Résumé] summary blocks",
        "index_path": "data/hybrid_indexes/hybrid_hyde_summaries",
        "similarity_threshold": 0.25,
        "chunk_strategy": "sentence_window",
        "sentence_window_size": 3,
        "hyde": true,
        "hyde_use_summaries": true,
        "hyde_prompt_key": "rag_manager.hyde_prompt",
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": true,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "structured_sheet": {
        "_comment": "Optimised for the Question/Concept clé/Pertinence/Développement/Mots-clés schema. Embeds signal fields only (Question + Concept clé + Mots-clés), returns full sheet as context. HyDE disabled — the Question field already acts as a built-in query expander. BM25 full blend recommended: keywords are diverse and discriminative across sheets.",
        "type": "hybrid",
        "enabled": false,
        "description": "Structured sheet parser — embeds signal fields, returns full sheet",
        "index_path": "data/hybrid_indexes/structured_sheet",
        "similarity_threshold": 0.25,
        "chunk_strategy": "structured_sheet",
        "hyde": false,
        "bm25_hybrid": true,
        "bm25_alpha": 0.5,
        "bm25_rerank_only": false,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "structured_sheet_bm25_heavy": {
        "_comment": "Structured sheet with heavier BM25 weight (alpha=0.7). Tests whether keyword-rich Mots-clés fields give BM25 enough discriminative power to warrant a larger blend share.",
        "type": "hybrid",
        "enabled": true,
        "description": "Structured sheet — BM25-heavy blend (alpha=0.7)",
        "index_path": "data/hybrid_indexes/structured_sheet_bm25_heavy",
        "similarity_threshold": 0.25,
        "chunk_strategy": "structured_sheet",
        "hyde": false,
        "bm25_hybrid": true,
        "bm25_alpha": 0.7,
        "bm25_rerank_only": false,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },
      "structured_sheet_dense_only": {
        "_comment": "Structured sheet with pure cosine search, no BM25. Baseline to measure the isolated contribution of the signal-field embedding strategy.",
        "type": "hybrid",
        "enabled": false,
        "description": "Structured sheet — dense only (BM25 disabled, cosine baseline)",
        "index_path": "data/hybrid_indexes/structured_sheet_dense_only",
        "similarity_threshold": 0.25,
        "chunk_strategy": "structured_sheet",
        "hyde": false,
        "bm25_hybrid": false,
        "use_summaries": true,
        "contextual_chunking": false,
        "contextual_model": null
      },

      "pageindex": {
        "type": "pageindex",
        "enabled": false,
        "description": "PageIndex vectorless reasoning-based RAG",
        "index_path": "data/pageindex_indexes/default",
        "pageindex_root": "vendor/PageIndex",
        "model": "gpt-4o-2024-11-20",
        "retrieve_model": "gpt-4o-2024-11-20",
        "toc_check_pages": 20,
        "max_pages_per_node": 10,
        "max_tokens_per_node": 20000,
        "if_add_node_id": true,
        "if_add_node_summary": true,
        "if_add_doc_description": true,
        "if_add_node_text": false,
        "max_results": 5,
        "content_preview_chars": 1800
      },

      "rrf_blend_sheet": {
        "_comment": "RRF fusion of hybrid_bm25_blend (strong on precise/factual queries L2-L4/L7) and structured_sheet (strong on semantic/paraphrase queries L5/L6/L9). Complementary strengths validated by benchmark.",
        "type": "rrf",
        "enabled": false,
        "description": "RRF ensemble: hybrid_bm25_blend + structured_sheet",
        "engine_a": "hybrid_bm25_blend",
        "engine_b": "structured_sheet",
        "rrf_k": 60,
        "limit": 5
      },

      "rrf_blend_sheet_heavy": {
        "_comment": "Same RRF fusion but using structured_sheet_bm25_heavy as engine_b. To benchmark once structured_sheet_bm25_heavy is correctly re-indexed.",
        "type": "rrf",
        "enabled": false,
        "description": "RRF ensemble: hybrid_bm25_blend + structured_sheet_bm25_heavy",
        "engine_a": "hybrid_bm25_blend",
        "engine_b": "structured_sheet_bm25_heavy",
        "rrf_k": 60,
        "limit": 5
      }
    }
  }
}
